    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "1.5.4",
    "@vue-flow/node-toolbar": "^1.1.1",
    "@vueuse/core": "^14.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.74",
    "ansi-to-vue3": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
