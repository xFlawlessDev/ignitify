# Copy to .env and replace values before starting backend.
IGNITIFY_DATABASE_URL=sqlite:data/ignitify.db
IGNITIFY_JWT_SECRET=replace-with-at-least-32-random-characters
IGNITIFY_SECURE_COOKIES=false
IGNITIFY_TRUSTED_ORIGINS=http://localhost:6565,http://127.0.0.1:6565
# Generate with: age-keygen
IGNITIFY_SECRETS_AGE_IDENTITY=AGE-SECRET-KEY-1...

# Compose runtime paths. Uncomment values for your platform.
# Linux:
# IGNITIFY_DOCKER_BIN=/usr/bin/docker
# IGNITIFY_COMPOSE_ROOT=/var/lib/ignitify/compose
# Windows PowerShell:
# IGNITIFY_DOCKER_BIN=C:/Program Files/Docker/Docker/resources/bin/docker.exe
# IGNITIFY_COMPOSE_ROOT=C:/Users/your-user/AppData/Local/Ignitify/compose
