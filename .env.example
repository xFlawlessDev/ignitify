# Optional overrides. Ignitify creates and persists runtime secrets on first start.
# IGNITIFY_DATABASE_URL=sqlite:data/ignitify.db
# IGNITIFY_SECURE_COOKIES=false
# IGNITIFY_TRUSTED_ORIGINS=http://localhost:6565,http://127.0.0.1:6565
# IGNITIFY_DATA_DIR=data
# IGNITIFY_JWT_SECRET=replace-with-at-least-32-random-characters
# IGNITIFY_SECRETS_AGE_IDENTITY=AGE-SECRET-KEY-1...

# Compose runtime paths. Uncomment values for your platform.
# IGNITIFY_DOCKER_HOST=tcp://127.0.0.1:2375
# IGNITIFY_AUTO_START_INGRESS=true
# IGNITIFY_TRAEFIK_COMPOSE_FILE=infra/traefik/compose.yaml
# Directory bind-mounted read-only into Traefik for generated TLS configuration and certificates.
# IGNITIFY_TRAEFIK_DYNAMIC_DIR=/var/lib/ignitify/traefik/dynamic
# Public routes are restricted to operator-owned suffixes. Leave unset to disable domain routing.
# IGNITIFY_ALLOWED_DOMAIN_SUFFIXES=apps.example.com,services.example.net
# Linux:
# IGNITIFY_DOCKER_BIN=/usr/bin/docker
# IGNITIFY_COMPOSE_ROOT=/var/lib/ignitify/compose
# Windows PowerShell:
# IGNITIFY_DOCKER_BIN=C:/Program Files/Docker/Docker/resources/bin/docker.exe
# IGNITIFY_COMPOSE_ROOT=C:/Users/your-user/AppData/Local/Ignitify/compose

# Git source build executor. Defaults are bundled; these values are optional overrides.
# IGNITIFY_SOURCE_BUILD_ROOT=/var/lib/ignitify/builds
# IGNITIFY_GIT_BIN=/usr/bin/git
# IGNITIFY_RAILPACK_BIN=/usr/local/bin/railpack
# IGNITIFY_STATIC_BUILD_IMAGE=node:22.23.1-alpine3.24@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2
# IGNITIFY_STATIC_RUNTIME_IMAGE=caddy:2.11.4-alpine@sha256:98eb57d882ccd5213d1688764db10c1ca2c58a1ca3a6717a3411ad798f7a423a
# IGNITIFY_RAILPACK_FRONTEND_IMAGE=ghcr.io/railwayapp/railpack-frontend:latest@sha256:bc73534934e7929ab3dc41765fb7e25c8c69d9be98c43ef8792fea51f65317bd
